def event3153 : BoundWire := bound_event% "IndexedFamilyProducer/HighD2/events/event3153.json"
theorem event3153_valid : event3153.Valid family := by
  refine ⟨rfl, ⟨AggregateTargetInventory.EventAudit.IndexedBatch3.event3153_valid, ?_⟩⟩
  refine ⟨by decide, family_unique, ?_, ?_, ?_⟩
  · decide
  · decide
  · decide
theorem event3153_differential : DifferentialAt family (keyAt event3153.object event3153.event.eventPage event3153.event.sourceDegree)
    event3153.event.finite.source event3153.event.finite.target := event3153_valid.2.differential
